{
  "rules": {
    "pairs": {
      "$pairId": {
        // Read allowed only to authenticated users (further constrained by pair membership)
        ".read": "auth != null",
        "locations": {
          "$userId": {
            // User can write their own live location
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.hasChildren(['latitude', 'longitude', 'timestamp']) && newData.child('latitude').isNumber() && newData.child('longitude').isNumber()"
          }
        }
      }
    }
  }
}
