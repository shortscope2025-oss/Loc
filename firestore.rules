rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPairedPartner(userId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerUid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Owner or paired spouse can read profile
      allow read: if isOwner(userId) || isPairedPartner(userId);
      // Only owner can update profile (e.g. name, compressed avatar, fcmToken)
      allow create, update: if isOwner(userId);
      // Owner can delete their account
      allow delete: if isOwner(userId);

      // Private notifications sub-collection
      match /notifications/{notifId} {
        allow read, delete: if isOwner(userId);
        // Paired spouse or backend can send geofence notification
        allow create: if isOwner(userId) || isPairedPartner(userId);
      }
    }

    // Pairs Collection
    match /pairs/{pairId} {
      // Only the two paired spouses can read or update their pair document
      allow read: if isAuthenticated() && (
        resource.data.user1Uid == request.auth.uid ||
        resource.data.user2Uid == request.auth.uid
      );
      
      // Creating pair requires user to be one of the partners
      allow create: if isAuthenticated() && (
        request.resource.data.user1Uid == request.auth.uid ||
        request.resource.data.user2Uid == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        resource.data.user1Uid == request.auth.uid ||
        resource.data.user2Uid == request.auth.uid
      );

      // Mirror locations sub-collection
      match /locations/{locUserId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/pairs/$(pairId)).data.user1Uid == request.auth.uid ||
          get(/databases/$(database)/documents/pairs/$(pairId)).data.user2Uid == request.auth.uid
        );
        allow write: if isOwner(locUserId);
      }
    }

    // Invitation Codes Collection
    match /invite_codes/{code} {
      // Authenticated users can read to validate and join
      allow read: if isAuthenticated();
      // Only creator can create their invite code
      allow create: if isAuthenticated() && request.resource.data.creatorUid == request.auth.uid;
      // Code can be marked as used during pairing
      allow update: if isAuthenticated() && (
        resource.data.creatorUid == request.auth.uid ||
        (resource.data.isUsed == false && request.resource.data.isUsed == true)
      );
      allow delete: if isAuthenticated() && resource.data.creatorUid == request.auth.uid;
    }
  }
}
